{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Wukong Codex",
  "version": "0.2.1",
  "identifier": "com.xboyzc.wukong-codex",
  "build": {
    "beforeDevCommand": "npm run web:dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run web:build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "WUKONG · CODEX",
        "width": 1440,
        "height": 900,
        "minWidth": 960,
        "minHeight": 620,
        "center": true,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline'; media-src 'self' asset: http://asset.localhost blob:; font-src 'self'",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPDATA/local-voice/generated/*.wav"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "DeveloperTool",
    "shortDescription": "Wake Wukong and work through Codex",
    "resources": [
      "audio-filters/std.rnnn",
      "voice-worker/voice_worker.py",
      "voice-worker/wukong-20260809-reference.wav",
      "voice-worker/wukong-20260809-reference-transcript.txt",
      "wake-helper/JarvisWakeListener.app/"
    ],
    "macOS": {
      "minimumSystemVersion": "13.0",
      "signingIdentity": "-",
      "entitlements": "Entitlements.plist",
      "infoPlist": "Info.plist"
    }
  }
}
